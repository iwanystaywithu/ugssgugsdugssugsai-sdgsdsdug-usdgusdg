<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GiftSniper Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Google Fonts for modern typography -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0f172a;
            color: #e2e8f0;
            background-image: 
                radial-gradient(at 0% 0%, hsla(253,16%,7%,1) 0, transparent 50%), 
                radial-gradient(at 50% 0%, hsla(225,39%,30%,0.2) 0, transparent 50%), 
                radial-gradient(at 100% 0%, hsla(339,49%,30%,0.2) 0, transparent 50%);
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border-radius: 1rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .glass-card:hover {
            border-color: rgba(99, 102, 241, 0.3);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
            transform: translateY(-2px);
        }

        /* Nav Bar */
        .glass-nav {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        /* Buttons */
        .btn-neon-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);
            color: white;
            transition: all 0.3s ease;
        }
        .btn-neon-blue:hover {
            box-shadow: 0 6px 20px 0 rgba(59, 130, 246, 0.5);
            transform: translateY(-1px);
        }
        
        .btn-neon-green {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 4px 14px 0 rgba(16, 185, 129, 0.39);
            color: white;
            transition: all 0.3s ease;
        }
        .btn-neon-green:hover {
            box-shadow: 0 6px 20px 0 rgba(16, 185, 129, 0.5);
            transform: translateY(-1px);
        }

        .btn-neon-red {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            box-shadow: 0 4px 14px 0 rgba(239, 68, 68, 0.39);
            color: white;
            transition: all 0.3s ease;
        }
        .btn-neon-red:hover {
            box-shadow: 0 6px 20px 0 rgba(239, 68, 68, 0.5);
            transform: translateY(-1px);
        }

        /* Gradient Texts */
        .text-gradient {
            background: linear-gradient(to right, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .text-gradient-green {
            background: linear-gradient(to right, #34d399, #10b981);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Custom Scrollbar for activity */
        .activity-feed::-webkit-scrollbar {
            width: 6px;
        }
        .activity-feed::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.1); 
            border-radius: 4px;
        }
        .activity-feed::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1); 
            border-radius: 4px;
        }
        .activity-feed::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.2); 
        }

        /* Notifications */
        .notification-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 100;
        }
        .notification {
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.1);
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            padding: 1rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            margin-top: 0.5rem;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .notification.success { background-color: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.3); }
        .notification.error { background-color: rgba(239, 68, 68, 0.2); color: #f87171; border-color: rgba(239, 68, 68, 0.3); }
        .notification.warning { background-color: rgba(245, 158, 11, 0.2); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3); }

        /* NFT Cards */
        .nft-image-container {
            position: relative;
            aspect-ratio: 1;
            width: 100%;
            overflow: hidden;
            border-radius: 0.75rem;
            background: rgba(255, 255, 255, 0.02);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .nft-image {
            width: 80%;
            height: 80%;
            object-fit: contain;
            transition: transform 0.5s ease;
        }
        .glass-card:hover .nft-image {
            transform: scale(1.1);
        }
        
        /* Log colors */
        .log-success { color: #34d399; }
        .log-error { color: #f87171; }
        .log-info { color: #60a5fa; }
        .log-warning { color: #fbbf24; }
    </style>
</head>
<body>
    <!-- Top Navigation -->
    <nav class="glass-nav py-4 px-6 md:px-12 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/30">
                <i class="fas fa-crosshairs text-white"></i>
            </div>
            <h1 class="text-xl md:text-2xl font-bold text-white tracking-wide">Gift<span class="text-gradient">Sniper</span></h1>
        </div>
        
        <div class="flex items-center space-x-4">
            <!-- Wallet Display -->
            <div class="hidden md:flex items-center space-x-4 bg-slate-800/50 px-4 py-2 rounded-full border border-slate-700">
                <div class="flex items-center">
                    <i class="fas fa-gem text-cyan-400 mr-2 text-sm"></i>
                    <span id="current-balance-ton" class="font-semibold text-white">{{ current_balance_ton }} TON</span>
                </div>
                <div class="w-px h-4 bg-slate-600"></div>
                <div class="flex items-center">
                    <i class="fas fa-star text-yellow-400 mr-2 text-sm"></i>
                    <span id="current-balance-stars" class="font-semibold text-white">{{ current_balance_stars }} ⭐</span>
                </div>
            </div>

            <!-- Actions -->
            <a href="/settings" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-gray-300 hover:text-white hover:bg-slate-700 transition">
                <i class="fas fa-cog"></i>
            </a>
            {% if is_admin %}
            <a href="/admin/dashboard" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-gray-300 hover:text-yellow-400 hover:bg-slate-700 transition">
                <i class="fas fa-user-shield"></i>
            </a>
            {% endif %}
            <form action="/logout" method="POST" class="inline">
                <button type="submit" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-gray-300 hover:text-red-400 hover:bg-slate-700 transition">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </form>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8 max-w-7xl">
        
        <!-- Hero / Control Panel -->
        <div class="glass-card p-8 mb-8 relative overflow-hidden">
            <!-- Decorative blur -->
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-blue-600/20 rounded-full blur-3xl"></div>
            
            <div class="flex flex-col md:flex-row justify-between items-center relative z-10">
                <div class="mb-6 md:mb-0">
                    <h2 class="text-3xl font-bold text-white mb-2">Bot Holati: 
                        <span id="bot-status-text" class="{% if bot_status %}text-gradient-green{% else %}text-red-400{% endif %}">
                            {% if bot_status %}Aktiv (Sniping){% else %}To'xtatilgan{% endif %}
                        </span>
                    </h2>
                    <p class="text-gray-400 flex items-center">
                        <i class="fas fa-clock mr-2"></i> Uptime: <span id="bot-runtime" class="ml-2 font-mono text-blue-300 tracking-wider text-lg">00:00:00</span>
                    </p>
                    <p class="text-gray-400 mt-1 flex items-center text-sm">
                        <i class="fas fa-sync-alt mr-2"></i> Skan oralig'i: <span class="text-white ml-1 font-semibold">{{ settings.SLEEP_BETWEEN_CYCLES }}s</span>
                    </p>
                </div>
                
                <div class="flex gap-4">
                    <button data-bot-status="{{ 'running' if bot_status else 'stopped' }}"
                        onclick="showConfirmDialog(this)"
                        class="px-8 py-3 rounded-xl font-bold text-lg flex items-center justify-center transition {% if bot_status %}btn-neon-red{% else %}btn-neon-green{% endif %} shadow-lg">
                        {% if bot_status %}
                        <i class="fas fa-stop-circle mr-2 text-xl"></i> Savdoni To'xtatish
                        {% else %}
                        <i class="fas fa-bolt mr-2 text-xl"></i> Snipingni Boshlash
                        {% endif %}
                    </button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Left Column: NFT Targets -->
            <div class="lg:col-span-2 space-y-8">
                
                <!-- Target Gifts (Marketplace Grid) -->
                <div>
                    <div class="flex justify-between items-end mb-6">
                        <h2 class="text-2xl font-bold text-white"><i class="fas fa-crosshairs text-blue-500 mr-2"></i> Sniping Maqsadlari</h2>
                        <a href="/settings/gift-limits" class="text-sm text-blue-400 hover:text-blue-300 flex items-center">Barchasini sozlash <i class="fas fa-arrow-right ml-1"></i></a>
                    </div>
                    
                    {% if settings.GIFT_LIMITS %}
                    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
                        {% for gift_name, limit in settings.GIFT_LIMITS.items() %}
                        {% set gift_id = GIFT_MAPPINGS|find_key(gift_name) %}
                        <div class="glass-card p-4 group cursor-pointer relative">
                            <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur rounded-full px-2 py-1 text-xs font-bold text-yellow-400 z-10 border border-yellow-500/30 shadow-lg">
                                Maks: {{ limit }}⭐
                            </div>
                            <div class="nft-image-container mb-4">
                                <i class="fas fa-spinner fa-spin text-gray-500 text-2xl absolute"></i>
                                {% if gift_id %}
                                <img src="{{ url_for('static', filename='gifts/' ~ gift_id ~ '.png') }}" alt="{{ gift_name }}" class="nft-image z-10" onload="this.previousElementSibling.style.display='none'">
                                {% else %}
                                <i class="fas fa-gift text-4xl text-gray-600 z-10"></i>
                                {% endif %}
                            </div>
                            <h3 class="font-semibold text-white truncate text-center">{{ gift_name }}</h3>
                            <div class="mt-2 w-full bg-blue-500/10 text-blue-400 text-xs text-center py-1.5 rounded-lg border border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white transition">
                                Qidirilmoqda
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="glass-card p-12 text-center border-dashed border-2 border-slate-700">
                        <i class="fas fa-robot text-6xl text-slate-600 mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-300">Maxsus Limitlar Yo'q</h3>
                        <p class="text-gray-500 mt-2">Barcha sovg'alar umumiy standart limit ({{ settings.DEFAULT_GIFTS_TO_BUY_MAX_PRICE }}⭐) narxida olinmoqda.</p>
                        <a href="/settings/gift-limits" class="mt-4 inline-block btn-neon-blue px-6 py-2 rounded-lg">Limitlarni qo'shish</a>
                    </div>
                    {% endif %}
                </div>

                <!-- Avoid Lists -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="glass-card p-6">
                        <h3 class="text-lg font-bold text-white mb-4"><i class="fas fa-ban text-red-500 mr-2"></i> Qora Ro'yxat (NFT)</h3>
                        {% if settings.GIFTS_NOT_TO_BUY %}
                        <div class="flex flex-wrap gap-2">
                            {% for gift in settings.GIFTS_NOT_TO_BUY %}
                            <span class="px-3 py-1.5 bg-red-500/10 border border-red-500/20 text-red-300 text-xs rounded-full flex items-center">
                                {{ gift }}
                            </span>
                            {% endfor %}
                        </div>
                        {% else %}
                        <p class="text-sm text-gray-500">Olinmaydigan sovg'alar kiritilmagan.</p>
                        {% endif %}
                    </div>
                    
                    <div class="glass-card p-6">
                        <h3 class="text-lg font-bold text-white mb-4"><i class="fas fa-image text-purple-500 mr-2"></i> Qora Ro'yxat (Fon)</h3>
                        {% if settings.BACKDROPS_NOT_TO_BUY %}
                        <div class="flex flex-wrap gap-2 max-h-32 overflow-y-auto pr-2">
                            {% for backdrop in settings.BACKDROPS_NOT_TO_BUY %}
                            <span class="px-3 py-1.5 bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs rounded-full flex items-center">
                                {% if backdrop in BACKDROP_CENTER_COLORS %}
                                <span class="w-2.5 h-2.5 rounded-full mr-2" style="background-color: {{ BACKDROP_CENTER_COLORS[backdrop] }}"></span>
                                {% endif %}
                                {{ backdrop }}
                            </span>
                            {% endfor %}
                        </div>
                        {% else %}
                        <p class="text-sm text-gray-500">Olinmaydigan fonlar kiritilmagan.</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Right Column: Activity & Subscription -->
            <div class="space-y-8">
                
                <!-- Subscription -->
                <div class="glass-card p-6 border-t-4 border-t-purple-500 relative overflow-hidden">
                    <div class="absolute -right-10 -bottom-10 opacity-10">
                        <i class="fas fa-crown text-9xl text-purple-500"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 relative z-10"><i class="fas fa-crown text-purple-400 mr-2"></i> Obuna Holati</h3>
                    {% if expiry_timestamp %}
                    <div id="subscription-info" data-expiry="{{ expiry_timestamp }}" style="display:none;"></div>
                    <div class="mt-4 relative z-10">
                        <div class="text-sm text-gray-400 mb-1">Amal qilish muddati:</div>
                        <div class="font-mono text-2xl font-bold text-white" id="countdown-timer">Yuklanmoqda...</div>
                        <div class="text-xs text-purple-300 mt-2" id="expiry-date">{{ expiry_date }}</div>
                    </div>
                    {% else %}
                    <div class="mt-4 relative z-10">
                        <div class="text-red-400 font-bold text-xl">Aktiv Obuna Yo'q</div>
                    </div>
                    {% endif %}
                </div>

                <!-- Activity Feed -->
                <div class="glass-card p-0 flex flex-col h-[500px]">
                    <div class="p-6 border-b border-slate-700/50 flex justify-between items-center bg-slate-800/30 rounded-t-xl">
                        <h3 class="text-lg font-bold text-white"><i class="fas fa-list-ul text-emerald-400 mr-2"></i> Tranzaksiyalar</h3>
                        <div class="flex space-x-1">
                            <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                        </div>
                    </div>
                    
                    <div class="flex-1 overflow-y-auto activity-feed p-4">
                        <ul id="quick-logs-content" class="space-y-3 font-mono text-sm leading-relaxed">
                            <!-- Logs injected here -->
                            <li class="text-center text-slate-500 py-8">
                                <i class="fas fa-satellite-dish text-3xl mb-2 opacity-50 block"></i>
                                Ma'lumot kutilmoqda...
                            </li>
                        </ul>
                    </div>
                    
                    <!-- Pagination (Hidden by default, updated via JS) -->
                    <div id="pagination-controls" class="p-4 border-t border-slate-700/50 flex justify-between items-center bg-slate-800/30 rounded-b-xl hidden">
                        <button id="prev-page" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-white rounded text-xs transition">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span id="page-info" class="text-xs text-slate-400"></span>
                        <button id="next-page" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-white rounded text-xs transition">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div id="confirmDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
        <div class="glass-card p-8 w-full max-w-sm transform scale-95 transition-transform duration-300 border-t-4 border-t-blue-500">
            <h2 class="text-xl font-bold mb-4 text-white" id="confirmTitle">Tasdiqlash</h2>
            <p class="text-gray-300 mb-6" id="confirmMessage">Rostan ham ushbu amalni bajarmoqchimisiz?</p>
            <div class="flex justify-end gap-3">
                <button onclick="closeConfirmDialog()" class="px-5 py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-white transition font-medium">Bekor qilish</button>
                <button id="confirmAction" class="px-5 py-2.5 rounded-lg text-white font-bold transition"></button>
            </div>
        </div>
    </div>

    <!-- Flash Notifications -->
    <div id="notification-container" class="notification-container"> 
        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
            <div class="notification {{ category }}">
                <i class="notification-icon 
                    {% if category == 'success' %}fas fa-check-circle text-emerald-400
                    {% elif category == 'error' %}fas fa-exclamation-circle text-red-400
                    {% elif category == 'warning' %}fas fa-exclamation-triangle text-amber-400
                    {% else %}fas fa-info-circle text-blue-400{% endif %}"></i>
                <span class="flex-1 text-sm font-medium">{{ message }}</span>
                <span class="notification-close ml-3 hover:text-white" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </span>
            </div>
            {% endfor %}
        {% endif %}
        {% endwith %}
    </div>

    <script src="{{ url_for('static', filename='js/index.js') }}"></script>
    
    <!-- Animation script for dialog -->
    <script>
        // Override the default confirm dialog behavior slightly to add animations
        const originalShow = window.showConfirmDialog;
        const originalClose = window.closeConfirmDialog;
        
        window.showConfirmDialog = function(btn) {
            const dialog = document.getElementById('confirmDialog');
            dialog.classList.remove('hidden');
            // small delay for transition to kick in
            setTimeout(() => {
                dialog.classList.remove('opacity-0');
                dialog.querySelector('.glass-card').classList.remove('scale-95');
                dialog.querySelector('.glass-card').classList.add('scale-100');
            }, 10);
            
            // set up the content
            const action = btn.getAttribute('data-bot-status') === 'running' ? 'stop' : 'start';
            const title = document.getElementById('confirmTitle');
            const msg = document.getElementById('confirmMessage');
            const actionBtn = document.getElementById('confirmAction');

            if (action === 'stop') {
                title.textContent = "Botni to'xtatish";
                title.className = "text-xl font-bold mb-4 text-red-400";
                msg.textContent = "Bot ishini to'xtatmoqchimisiz? Sniping jarayoni to'xtaydi.";
                actionBtn.textContent = "To'xtatish";
                actionBtn.className = "px-5 py-2.5 rounded-lg font-bold transition btn-neon-red text-white";
            } else {
                title.textContent = "Botni ishga tushirish";
                title.className = "text-xl font-bold mb-4 text-green-400";
                msg.textContent = "Botni ishga tushirmoqchimisiz? Sniping boshlanadi.";
                actionBtn.textContent = "Ishga Tushirish";
                actionBtn.className = "px-5 py-2.5 rounded-lg font-bold transition btn-neon-green text-white";
            }
            
            actionBtn.onclick = () => {
                // Remove the actionBtn onclick since we will use the fetch api provided by toggleBot function in index.js
                closeConfirmDialog();
                if (typeof toggleBot === "function") {
                    toggleBot();
                }
            };
        };
        
        window.closeConfirmDialog = function() {
            const dialog = document.getElementById('confirmDialog');
            dialog.classList.add('opacity-0');
            dialog.querySelector('.glass-card').classList.remove('scale-100');
            dialog.querySelector('.glass-card').classList.add('scale-95');
            setTimeout(() => {
                dialog.classList.add('hidden');
            }, 300);
        };
    </script>
</body>
</html>
